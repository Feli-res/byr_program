# Copy to the PRIVATE shared/.env.prod. Use random hexadecimal values; never commit actual secrets.
MYSQL_DATABASE=youzhihui_trial
MYSQL_USER=youzhihui
MYSQL_PASSWORD=CHANGE_ME_48_HEX_CHARACTERS
MYSQL_ROOT_PASSWORD=CHANGE_ME_48_HEX_CHARACTERS
AUTH_SECRET=CHANGE_ME_AT_LEAST_64_HEX_CHARACTERS
TRUSTED_PROXY_KEY=CHANGE_ME_AT_LEAST_64_HEX_CHARACTERS
WEB_ORIGIN=https://YOUR_DOMAIN
RUST_LOG=info,sqlx::query=error

# Text AI remains disabled until a private key is configured on the server.
AI_ENABLED=false
DEEPSEEK_API_KEY=
