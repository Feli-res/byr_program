# Prepare-Dev.ps1 creates deploy/.env with random local passwords.
MYSQL_DATABASE=youzhihui_dev
MYSQL_USER=youzhihui_dev
MYSQL_PASSWORD=CHANGE_ME_RANDOM_USER_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_RANDOM_ROOT_PASSWORD
MYSQL_PORT=23307
REDIS_PORT=26380
API_BIND=127.0.0.1:8080
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:8080
DEV_TOOLS_ENABLED=true
RUST_LOG=info

# Generate locally; never commit deploy/.env.
AUTH_SECRET=CHANGE_ME_RANDOM_AUTH_SECRET
COOKIE_SECURE=false
UPLOAD_ROOT=.local/uploads
